{
  "name": "playwright-automation-framework",
  "version": "0.1.0",
  "private": true,
  "description": "UI and API test automation framework built with Playwright Test and TypeScript",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:unit": "playwright test --project=unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "playwright show-report",
    "report:scan": "node --experimental-strip-types --no-warnings scripts/report-scan-cli.ts playwright-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
