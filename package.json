{
  "name": "playwright-automation-framework",
  "version": "0.1.0",
  "private": true,
  "description": "UI and API test automation framework built with Playwright Test and TypeScript",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
